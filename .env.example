# ===========================================
# Required Infrastructure Variables
# ===========================================
# These are required server-only variables.
# Clients can only access NEXT_PUBLIC_* variables.

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5434/gotly_keeper_dev

# Redis
REDIS_URL=redis://localhost:6382/0
# Set this in production when sharing one Redis across multiple apps.
REDIS_KEY_PREFIX=gotly-keeper

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Email
RESEND_KEY=re_replace_with_your_resend_key

# AI SDK
# These are required for full AI functionality, including semantic search.
AI_GATEWAY_API_KEY=xxx
AI_GATEWAY_URL=http://localhost:8000
AI_MODEL_NAME=qwen3-max
AI_EMBEDDING_MODEL_NAME=text-embedding-v4
# Must match the current pgvector schema dimensions.
AI_EMBEDDING_DIMENSIONS=1024
# Optional GitHub OAuth. If omitted, the GitHub sign-in buttons stay hidden.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ===========================================
# Drizzle Migrations
# ===========================================
# Generate migrations after schema changes:
#   pnpm db:generate
#
# Apply migrations to database:
#   pnpm db:migrate
#
# Open Drizzle Studio (browser-based database explorer):
#   pnpm db:studio
